{
  "publisher": "codeurjc",
  "name": "vscode-codeurjc-slidev",
  "displayName": "CodeURJC Slidev Theme Support",
  "type": "module",
  "version": "0.1.0",
  "description": "Editor support for codeurjc-slidev-theme's custom slides.md grammar: marker/anchor decorations, hovers, diagnostics, and reverse code references.",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeurjc-slidev.openReference",
        "title": "CodeURJC Slidev: Open referencing slide"
      },
      {
        "command": "codeurjc-slidev.copySelectorForSelection",
        "title": "CodeURJC Slidev: Copy Selector for Selection"
      },
      {
        "command": "codeurjc-slidev.pasteSelectorIntoImport",
        "title": "CodeURJC Slidev: Paste Selector into Import"
      },
      {
        "command": "codeurjc-slidev.openImportedFile",
        "title": "CodeURJC Slidev: Open imported file"
      },
      {
        "command": "codeurjc-slidev.openImportSource",
        "title": "CodeURJC Slidev: Open source"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "test": "vitest",
    "test:extension": "node esbuild.js && node ./test-extension/runTest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "codeurjc-slidev-theme": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "mocha": "^10.8.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
