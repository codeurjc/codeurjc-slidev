{
  "name": "create-codeurjc-slidev",
  "type": "module",
  "version": "0.1.1",
  "description": "Scaffold a new Slidev presentation using the CodeURJC theme (draggable layout editor, code-highlight callouts, snippet import, title carry-over)",
  "license": "MIT",
  "main": "index.mjs",
  "bin": {
    "create-codeurjc-slidev": "index.mjs"
  },
  "files": [
    "dist",
    "index.mjs",
    "project-dir.mjs",
    "template"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "ansis": "^4.4.0",
    "fflate": "^0.8.3",
    "minimist": "^1.2.8",
    "pathe": "^2.0.3",
    "prompts": "^2.4.2",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "codeurjc-slidev-theme": "workspace:*",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
