{
  "name": "codeurjc-slidev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "slidev --remote --open",
    "build": "slidev build",
    "export": "slidev export",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "pnpm --filter codeurjc-slidev-theme --filter vscode-codeurjc-slidev --filter create-codeurjc-slidev run typecheck",
    "test": "pnpm --filter codeurjc-slidev-theme --filter vscode-codeurjc-slidev --filter create-codeurjc-slidev test",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:extension": "pnpm --filter vscode-codeurjc-slidev test:extension",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/client": "^52.19.1",
    "codeurjc-slidev-theme": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "lint-staged": "^17.5.1",
    "playwright-chromium": "1.63.0",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,vue,json,md}": [
      "eslint --fix --cache"
    ]
  }
}
